]

async def seed():
    db = await get_collection()
    collection = db["internal_users"]

    for user in USERS:
        existing = await collection.find_one({"email": user["email"]})
        if existing:
            print(f"Usuario ya existe: {user['email']}")
        else:
            await collection.insert_one(user)
            print(f"Usuario creado: {user['email']}")

if __name__ == "__main__":
    asyncio.run(seed())
